# ===========================================
# ATHENA — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ===========================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Redis (Upstash) ---
REDIS_URL=

# --- Neo4j AuraDB ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Modal ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Tavily (Web Search) ---
TAVILY_API_KEY=

# --- Cloudflare R2 (File Storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=athena-files

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App Config ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
