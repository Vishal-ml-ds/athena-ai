# ATHENA Backend — Environment Variables
# Copy this file to .env and fill in real values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Euri AI (OpenAI-compatible gateway — get free key at euron.one)
EURI_API_KEY=euri-your-key-here

# Redis (Upstash free tier for production)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3005,http://localhost:3000

# URLs
FRONTEND_URL=http://localhost:3005
BACKEND_URL=http://localhost:8005

# Environment
ENVIRONMENT=development
